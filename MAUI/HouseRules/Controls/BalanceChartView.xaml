<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:models="clr-namespace:HouseRules.Models"
             x:Class="HouseRules.Controls.BalanceChartView">

    <Border Style="{StaticResource CardStyle}">
        <VerticalStackLayout>
            <Label Text="Balance Over Time" Style="{StaticResource Title3}" Margin="0,0,0,10" />
            <chart:SfCartesianChart x:Name="BalanceChart" HeightRequest="250">
                <chart:SfCartesianChart.TrackballBehavior>
                    <chart:ChartTrackballBehavior DisplayMode="NearestPoint" ShowMarkers="True" />
                </chart:SfCartesianChart.TrackballBehavior>
                <chart:SfCartesianChart.XAxes>
                    <chart:CategoryAxis LabelPlacement="BetweenTicks" ShowMajorGridLines="False">
                        <chart:CategoryAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle FontSize="10" />
                        </chart:CategoryAxis.LabelStyle>
                    </chart:CategoryAxis>
                </chart:SfCartesianChart.XAxes>
                <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis ShowMajorGridLines="True">
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle FontSize="10" LabelFormat="$#,##0" />
                        </chart:NumericalAxis.LabelStyle>
                        <chart:NumericalAxis.MajorGridLineStyle>
                            <chart:ChartLineStyle Stroke="#2A2A3E" StrokeWidth="0.5" />
                        </chart:NumericalAxis.MajorGridLineStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.YAxes>
                <!-- Historical credit bars (green) -->
                <chart:RangeColumnSeries x:Name="CreditSeries"
                                         XBindingPath="Label" High="CreditHigh" Low="CreditLow"
                                         Fill="#39FF14" Opacity="0.35" Width="0.4" Label="Credits"
                                         ShowTrackballLabel="False" EnableTooltip="False" />
                <!-- Historical debit bars (red) -->
                <chart:RangeColumnSeries x:Name="DebitSeries"
                                         XBindingPath="Label" High="DebitHigh" Low="DebitLow"
                                         Fill="#FF4444" Opacity="0.35" Width="0.4" Label="Debits"
                                         ShowTrackballLabel="False" EnableTooltip="False" />
                <!-- Historical balance line (solid) -->
                <chart:LineSeries x:Name="BalanceLine"
                                  XBindingPath="Label" YBindingPath="HistBalance"
                                  StrokeWidth="2.5" Fill="{StaticResource Primary}"
                                  Label="Balance" ShowMarkers="True" EnableTooltip="False">
                    <chart:LineSeries.MarkerSettings>
                        <chart:ChartMarkerSettings Type="Circle" Width="8" Height="8"
                                                    Fill="{StaticResource Primary}"
                                                    Stroke="White" StrokeWidth="2" />
                    </chart:LineSeries.MarkerSettings>
                </chart:LineSeries>
                <!-- Future credit bars (green, faded) -->
                <chart:RangeColumnSeries x:Name="FutureCreditSeries"
                                         XBindingPath="Label" High="FutureCreditHigh" Low="FutureCreditLow"
                                         Fill="#39FF14" Opacity="0.15" Width="0.4"
                                         ShowTrackballLabel="False" EnableTooltip="False" IsVisibleOnLegend="False" />
                <!-- Future debit bars (red, faded) -->
                <chart:RangeColumnSeries x:Name="FutureDebitSeries"
                                         XBindingPath="Label" High="FutureDebitHigh" Low="FutureDebitLow"
                                         Fill="#FF4444" Opacity="0.15" Width="0.4"
                                         ShowTrackballLabel="False" EnableTooltip="False" IsVisibleOnLegend="False" />
                <!-- Future balance line (dashed) -->
                <chart:LineSeries x:Name="FutureBalanceLine"
                                  XBindingPath="Label" YBindingPath="FutureBalance"
                                  StrokeWidth="2" Fill="{StaticResource Primary}" Opacity="0.6"
                                  StrokeDashArray="6,4"
                                  ShowMarkers="True" EnableTooltip="False" IsVisibleOnLegend="False">
                    <chart:LineSeries.MarkerSettings>
                        <chart:ChartMarkerSettings Type="Circle" Width="8" Height="8"
                                                    Fill="White"
                                                    Stroke="{StaticResource Primary}" StrokeWidth="2" />
                    </chart:LineSeries.MarkerSettings>
                </chart:LineSeries>
                <chart:SfCartesianChart.Legend>
                    <chart:ChartLegend Placement="Bottom" />
                </chart:SfCartesianChart.Legend>
            </chart:SfCartesianChart>
        </VerticalStackLayout>
    </Border>

</ContentView>
