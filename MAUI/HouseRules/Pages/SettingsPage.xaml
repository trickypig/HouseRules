<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:HouseRules.PageModels"
             xmlns:models="clr-namespace:HouseRules.Models"
             x:Class="HouseRules.Pages.SettingsPage"
             x:DataType="pm:SettingsPageModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="{StaticResource LayoutPadding}">

            <Label Text="Settings" Style="{StaticResource Title1}" />

            <!-- Profile -->
            <Label Text="Profile" Style="{StaticResource Title2}" />
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Display Name" Style="{StaticResource Caption1}" />
                    <Entry Text="{Binding DisplayName}" Placeholder="Display Name" />
                    <Label Text="Family Display Name" Style="{StaticResource Caption1}" />
                    <Entry Text="{Binding FamilyDisplayName}" Placeholder='e.g. "Mom", "Dad"' />
                    <Label Text="What your kids see (e.g. Dad, Mom). Leave empty to use your display name."
                           Style="{StaticResource Caption2}" Opacity="0.7" />
                    <Button Text="Save Profile" Command="{Binding SaveProfileCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Household (parent only) -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding IsParent}">
                <Label Text="Household" Style="{StaticResource Title2}" />
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <!-- Household Name -->
                        <Label Text="Household Name" Style="{StaticResource Caption1}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Text="{Binding HouseholdName}" Placeholder="Household Name" />
                            <Button Grid.Column="1" Text="Save" Command="{Binding SaveHouseholdNameCommand}" />
                        </Grid>

                        <!-- Members -->
                        <Label Text="Members" Style="{StaticResource Caption1}" Margin="0,10,0,0" />
                        <CollectionView ItemsSource="{Binding Members}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:HouseholdMember">
                                    <Label Style="{StaticResource Body2}" Margin="0,2">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding DisplayName}" FontAttributes="Bold" />
                                                <Span Text="{Binding FamilyDisplayName, StringFormat=' ({0})'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Invite Code -->
                        <Label Text="Invite Code" Style="{StaticResource Caption1}" Margin="0,10,0,0" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding InviteCode}" Style="{StaticResource Body1Strong}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Regenerate" Command="{Binding RegenerateInviteCodeCommand}" />
                        </Grid>
                        <Label Text="Share this code with another parent to let them join your household."
                               Style="{StaticResource Caption2}" Opacity="0.5" />

                        <!-- Join Another Household -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                 Margin="0,10" />
                        <Button Text="Join Another Household" Command="{Binding ToggleJoinHouseholdCommand}"
                                BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                                IsVisible="{Binding ShowJoinHousehold, Converter={StaticResource InvertedBoolConverter}}" />
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowJoinHousehold}">
                            <Label Text="Join Another Household" Style="{StaticResource Body1Strong}" />
                            <Entry Text="{Binding JoinInviteCode}" Placeholder="Enter invite code" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Join" Command="{Binding JoinHouseholdCommand}" />
                                <Button Text="Cancel" Command="{Binding ToggleJoinHouseholdCommand}"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Kids Management -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Kids" Style="{StaticResource Title2}" />
                    <Button Grid.Column="1" Text="+ Add Kid" Command="{Binding ToggleAddKidCommand}" Padding="10,5" />
                </Grid>

                <!-- Add Kid Form -->
                <Border Style="{StaticResource CardStyle}" IsVisible="{Binding ShowAddKid}">
                    <VerticalStackLayout Spacing="10">
                        <Entry Placeholder="Kid's name" Text="{Binding NewKidName}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="Color" Style="{StaticResource Caption1}" />
                                <Entry Text="{Binding NewKidColor}" Placeholder="#4A90D9" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Avatar (emoji)" Style="{StaticResource Caption1}" />
                                <Entry Text="{Binding NewKidAvatar}" Placeholder="e.g. &#128522;" />
                            </VerticalStackLayout>
                        </Grid>
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Add Kid" Command="{Binding AddKidCommand}" />
                            <Button Text="Cancel" Command="{Binding ToggleAddKidCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Kids List -->
                <CollectionView ItemsSource="{Binding Kids}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Kid">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <!-- Avatar circle -->
                                    <Border WidthRequest="40" HeightRequest="40"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{Binding Color}"
                                            StrokeThickness="0">
                                        <Label Text="{Binding Avatar}" HorizontalOptions="Center" VerticalOptions="Center"
                                               FontSize="16" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource Body1Strong}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Delete"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pm:SettingsPageModel}}, Path=DeleteKidCommand}"
                                            CommandParameter="{Binding}" BackgroundColor="{StaticResource NeonDanger}" TextColor="White" Padding="10,5" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No kids added yet." Style="{StaticResource Body1}" Opacity="0.5" Margin="0,5" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Logout -->
            <Button Text="Log Out" Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource NeonDanger}" Margin="0,20,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
