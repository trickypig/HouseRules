<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:HouseRules.PageModels"
             xmlns:models="clr-namespace:HouseRules.Models"
             xmlns:util="clr-namespace:HouseRules.Utilities"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:HouseRules.Controls"
             x:Class="HouseRules.Pages.KidDetailPage"
             x:DataType="pm:KidDetailPageModel"
             Title="{Binding Kid.Name}">

    <ContentPage.Resources>
        <util:CurrencyConverter x:Key="CurrencyConverter" />
        <util:DateDisplayConverter x:Key="DateDisplayConverter" />
        <util:ColorConverter x:Key="ColorConverter" />
        <util:BalanceColorConverter x:Key="BalanceColorConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="{StaticResource LayoutPadding}">

                <!-- Kid Header Card -->
                <Border Style="{StaticResource CardStyle}">
                    <!-- View mode -->
                    <Grid IsVisible="{Binding IsEditingKid, Converter={StaticResource InvertedBoolConverter}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Border StrokeShape="RoundRectangle 25" WidthRequest="50" HeightRequest="50"
                                    BackgroundColor="{Binding Kid.Color, Converter={StaticResource ColorConverter}}">
                                <Label Text="{Binding Kid.Avatar}" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Kid.Name}" Style="{StaticResource Title2}" />
                                <Label Text="{Binding Kid.Balance, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource Title3}"
                                       TextColor="{Binding Kid.Balance, Converter={StaticResource BalanceColorConverter}}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Edit" Command="{Binding StartEditKidCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Kid Edit Form -->
                <Border Style="{StaticResource CardStyle}" IsVisible="{Binding IsEditingKid}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Edit Kid" Style="{StaticResource Title3}" />
                        <Entry Placeholder="Name" Text="{Binding EditKidName}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="Color" Style="{StaticResource Caption1}" />
                                <Entry Text="{Binding EditKidColor}" Placeholder="#hex" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Avatar Emoji" Style="{StaticResource Caption1}" />
                                <Entry Text="{Binding EditKidAvatar}" Placeholder="emoji" />
                            </VerticalStackLayout>
                        </Grid>
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Save" Command="{Binding SaveKidCommand}" />
                            <Button Text="Cancel" Command="{Binding CancelEditKidCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                            <Button Text="Delete Kid" Command="{Binding DeleteKidCommand}"
                                    BackgroundColor="{StaticResource NeonDanger}" HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Kid Login Section -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Kid Login" Style="{StaticResource Title3}" />

                        <!-- Has login - view mode -->
                        <Grid IsVisible="{Binding ShowKidLoginView}"
                              ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{Binding KidLogin.Email}" Style="{StaticResource Body1}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Edit" Command="{Binding StartEditKidLoginCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="10,5" />
                            <Button Grid.Column="2" Text="Remove" Command="{Binding RemoveKidLoginCommand}"
                                    BackgroundColor="{StaticResource NeonDanger}" Padding="10,5" />
                        </Grid>

                        <!-- Has login - edit mode -->
                        <VerticalStackLayout IsVisible="{Binding IsEditingKidLogin}" Spacing="8">
                            <Entry Placeholder="Email" Text="{Binding EditKidLoginEmail}" Keyboard="Email" />
                            <Entry Placeholder="New password (leave blank to keep)" Text="{Binding EditKidLoginPassword}" IsPassword="True" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveKidLoginCommand}" Padding="10,5" />
                                <Button Text="Cancel" Command="{Binding CancelEditKidLoginCommand}"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="10,5" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- No login -->
                        <VerticalStackLayout IsVisible="{Binding ShowKidLoginCreate}">
                            <Button Text="Create Kid Login" Command="{Binding ToggleKidLoginFormCommand}"
                                    IsVisible="{Binding ShowKidLoginForm, Converter={StaticResource InvertedBoolConverter}}" />
                            <VerticalStackLayout IsVisible="{Binding ShowKidLoginForm}" Spacing="8">
                                <Entry Placeholder="Email" Text="{Binding KidLoginEmail}" Keyboard="Email" />
                                <Entry Placeholder="Password (min 4 chars)" Text="{Binding KidLoginPassword}" IsPassword="True" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Create Login" Command="{Binding CreateKidLoginCommand}" />
                                    <Button Text="Cancel" Command="{Binding ToggleKidLoginFormCommand}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Balance Chart -->
                <controls:BalanceChartView ChartData="{Binding ChartData}" Goals="{Binding Goals}"
                                           IsVisible="{Binding ChartData.Count, Converter={StaticResource IsNotNullConverter}}" />

                <!-- Goals + Recurring side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <!-- Savings Goals -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Savings Goals" Style="{StaticResource Title2}" />
                            <Button Grid.Column="1" Text="+ Add Goal" Command="{Binding ToggleAddGoalCommand}" Padding="8,4"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" IsVisible="{Binding ShowAddGoal}">
                            <VerticalStackLayout Spacing="8">
                                <Entry Placeholder="Goal Name" Text="{Binding GoalName}" />
                                <Entry Placeholder="Target Amount" Text="{Binding GoalTargetText}" Keyboard="Numeric" />
                                <DatePicker Date="{Binding GoalWantByDate}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Create" Command="{Binding SubmitGoalCommand}" Padding="10,5" />
                                    <Button Text="Cancel" Command="{Binding ToggleAddGoalCommand}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="10,5" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <CollectionView ItemsSource="{Binding Goals}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SavingsGoal">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Name}" Style="{StaticResource Body1Strong}" />
                                                <Label Style="{StaticResource Caption1}" Opacity="0.7">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding CurrentAmount, Converter={StaticResource CurrencyConverter}}" />
                                                            <Span Text=" / " />
                                                            <Span Text="{Binding TargetAmount, Converter={StaticResource CurrencyConverter}}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <ProgressBar Progress="{Binding CurrentAmount}" ProgressColor="{StaticResource Primary}" />
                                                <Label Text="{Binding WantByDate, Converter={StaticResource DateDisplayConverter}, StringFormat='Want by: {0}'}"
                                                       Style="{StaticResource Caption2}" Opacity="0.7"
                                                       IsVisible="{Binding WantByDate, Converter={StaticResource IsNotNullConverter}}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                <Button Text="^"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=MoveGoalUpCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="4" WidthRequest="30" HeightRequest="28" />
                                                <Button Text="X"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=DeleteGoalCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource NeonDanger}" Padding="4" WidthRequest="30" HeightRequest="28" />
                                                <Button Text="v"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=MoveGoalDownCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="4" WidthRequest="30" HeightRequest="28" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No goals yet" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Recurring -->
                    <VerticalStackLayout Grid.Column="1" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recurring" Style="{StaticResource Title2}" />
                            <Button Grid.Column="1" Text="+ Add" Command="{Binding ToggleAddRecurringCommand}" Padding="8,4"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" IsVisible="{Binding ShowAddRecurring}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout>
                                        <Label Text="Type" Style="{StaticResource Caption1}" />
                                        <Picker ItemsSource="{Binding Types}" SelectedItem="{Binding RecType}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Category" Style="{StaticResource Caption1}" />
                                        <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding RecCategory}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout>
                                        <Label Text="Amount" Style="{StaticResource Caption1}" />
                                        <Entry Placeholder="0.00" Text="{Binding RecAmountText}" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Frequency" Style="{StaticResource Caption1}" />
                                        <Picker ItemsSource="{Binding Frequencies}" SelectedItem="{Binding RecFrequency}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Entry Placeholder="Description" Text="{Binding RecDescription}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout>
                                        <Label Text="Day of Week" Style="{StaticResource Caption1}" />
                                        <Picker ItemsSource="{Binding DaysOfWeek}" SelectedIndex="{Binding RecDayOfWeek}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Start Date" Style="{StaticResource Caption1}" />
                                        <DatePicker Date="{Binding RecStartDate}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Create" Command="{Binding SubmitRecurringCommand}" Padding="10,5" />
                                    <Button Text="Cancel" Command="{Binding ToggleAddRecurringCommand}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="10,5" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <CollectionView ItemsSource="{Binding RecurringTransactions}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RecurringTransaction">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <VerticalStackLayout Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding AmountDisplay}" Style="{StaticResource Body1Strong}" />
                                                <Label Style="{StaticResource Caption1}" Opacity="0.9" VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Category}" />
                                                            <Span Text=" · " />
                                                            <Span Text="{Binding Frequency}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Border BackgroundColor="{StaticResource Gray300}" Padding="4,1" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 4"
                                                        IsVisible="{Binding IsPaused}">
                                                    <Label Text="Paused" Style="{StaticResource Caption2}" TextColor="{StaticResource Gray500}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Description}" Style="{StaticResource Caption1}" Opacity="0.9"
                                                   IsVisible="{Binding Description, Converter={StaticResource IsNotEmptyConverter}}" />
                                            <Label Text="{Binding StartDateDisplay}" Style="{StaticResource Caption2}" Opacity="0.8" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Button Text="{Binding ToggleIcon}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=ToggleRecurringActiveCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                                                        Padding="4" WidthRequest="30" HeightRequest="28" />
                                                <Button Text="X"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=DeleteRecurringCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource NeonDanger}"
                                                        Padding="4" WidthRequest="30" HeightRequest="28" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No recurring income" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>

                <!-- Transactions Header -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="Transactions" Style="{StaticResource Title2}" />
                    <Button Grid.Column="1" Text="Verify All" Command="{Binding VerifyAllPendingCommand}"
                            BackgroundColor="{StaticResource NeonSuccess}" Padding="10,5" />
                    <Button Grid.Column="2" Text="+ Add" Command="{Binding ToggleAddTransactionCommand}" Padding="10,5" />
                </Grid>

                <!-- Add Transaction Form -->
                <Border Style="{StaticResource CardStyle}" IsVisible="{Binding ShowAddTransaction}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="Type" Style="{StaticResource Caption1}" />
                                <Picker ItemsSource="{Binding Types}" SelectedItem="{Binding TxType}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Category" Style="{StaticResource Caption1}" />
                                <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding TxCategory}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Entry Placeholder="Amount" Text="{Binding TxAmountText}" Keyboard="Numeric" />
                            <DatePicker Grid.Column="1" Date="{Binding TxDate}" />
                        </Grid>
                        <Entry Placeholder="Description" Text="{Binding TxDescription}" />
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Add" Command="{Binding SubmitTransactionCommand}" />
                            <Button Text="Cancel" Command="{Binding ToggleAddTransactionCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Transactions: Recent + Future side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <!-- Recent -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Recent" Style="{StaticResource Title3}" />
                        <CollectionView ItemsSource="{Binding RecentTransactions}" SelectionMode="None"
                                        RemainingItemsThreshold="5"
                                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreTransactionsCommand}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Transaction">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Description}" Style="{StaticResource Body1}" />
                                                <Label Style="{StaticResource Caption1}" Opacity="0.7">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TransactionDate, Converter={StaticResource DateDisplayConverter}}" />
                                                            <Span Text=" | " />
                                                            <Span Text="{Binding Status}" />
                                                            <Span Text=" | " />
                                                            <Span Text="{Binding Category}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource Body1Strong}" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="X"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=DeleteTransactionCommand}"
                                                    CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource NeonDanger}" Padding="5" WidthRequest="30" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No recent transactions" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                            <CollectionView.Footer>
                                <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" />
                            </CollectionView.Footer>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Future -->
                    <VerticalStackLayout Grid.Column="1" Spacing="10">
                        <Label Text="Future" Style="{StaticResource Title3}" />
                        <CollectionView ItemsSource="{Binding FutureTransactions}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Transaction">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Description}" Style="{StaticResource Body1}" />
                                                <Label Text="{Binding TransactionDate, Converter={StaticResource DateDisplayConverter}}"
                                                       Style="{StaticResource Caption1}" Opacity="0.7" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource Body1Strong}" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="X"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidDetailPageModel}}, Path=DeleteTransactionCommand}"
                                                    CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource NeonDanger}" Padding="5" WidthRequest="30" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No future transactions" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
