<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:HouseRules.PageModels"
             xmlns:models="clr-namespace:HouseRules.Models"
             xmlns:util="clr-namespace:HouseRules.Utilities"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:controls="clr-namespace:HouseRules.Controls"
             x:Class="HouseRules.Pages.KidMoneyPage"
             x:DataType="pm:KidMoneyPageModel"
             Title="My Money">

    <ContentPage.Resources>
        <util:CurrencyConverter x:Key="CurrencyConverter" />
        <util:DateDisplayConverter x:Key="DateDisplayConverter" />
        <util:BalanceColorConverter x:Key="BalanceColorConverter" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="{StaticResource LayoutPadding}">

                <!-- Balance -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="My Balance" Style="{StaticResource Body1}" HorizontalTextAlignment="Center" Opacity="0.7" />
                        <Label Text="{Binding Kid.Balance, Converter={StaticResource CurrencyConverter}}"
                               Style="{StaticResource Display}" HorizontalTextAlignment="Center"
                               TextColor="{Binding Kid.Balance, Converter={StaticResource BalanceColorConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Request Buttons -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button Text="I Spent Money" Command="{Binding ToggleRequestTypeCommand}" CommandParameter="spending" />
                    <Button Text="I Got a Gift" Command="{Binding ToggleRequestTypeCommand}" CommandParameter="gift" />
                    <Button Text="I Did a Chore" Command="{Binding ToggleRequestTypeCommand}" CommandParameter="chore" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource CardStyle}" IsVisible="{Binding ActiveRequestType, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="10">
                        <Entry Placeholder="Amount" Text="{Binding RequestAmountText}" Keyboard="Numeric" />
                        <Entry Placeholder="What for?" Text="{Binding RequestDescription}" />
                        <Button Text="Send Request" Command="{Binding SubmitRequestCommand}" />
                        <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource NeonSuccess}"
                               IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNullConverter}}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Goals + Recurring side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <!-- Savings Goals -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Savings Goals" Style="{StaticResource Title2}" />
                            <Button Grid.Column="1" Text="+ Add Goal" Command="{Binding ToggleAddGoalCommand}" Padding="8,4"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" IsVisible="{Binding ShowAddGoal}">
                            <VerticalStackLayout Spacing="8">
                                <Entry Placeholder="Goal Name" Text="{Binding GoalName}" />
                                <Entry Placeholder="Target Amount" Text="{Binding GoalTargetText}" Keyboard="Numeric" />
                                <DatePicker Date="{Binding GoalWantByDate}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Create" Command="{Binding SubmitGoalCommand}" Padding="10,5" />
                                    <Button Text="Cancel" Command="{Binding ToggleAddGoalCommand}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="10,5" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <CollectionView ItemsSource="{Binding Goals}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SavingsGoal">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Name}" Style="{StaticResource Body1Strong}" />
                                                <Label Style="{StaticResource Caption1}" Opacity="0.7">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding CurrentAmount, Converter={StaticResource CurrencyConverter}}" />
                                                            <Span Text=" / " />
                                                            <Span Text="{Binding TargetAmount, Converter={StaticResource CurrencyConverter}}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <ProgressBar Progress="{Binding CurrentAmount}" ProgressColor="{StaticResource Primary}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                <Button Text="^"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidMoneyPageModel}}, Path=MoveGoalUpCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="4" WidthRequest="30" HeightRequest="28" />
                                                <Button Text="X"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidMoneyPageModel}}, Path=DeleteGoalCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource NeonDanger}" Padding="4" WidthRequest="30" HeightRequest="28" />
                                                <Button Text="v"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:KidMoneyPageModel}}, Path=MoveGoalDownCommand}"
                                                        CommandParameter="{Binding}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="4" WidthRequest="30" HeightRequest="28" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No goals yet" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Recurring -->
                    <VerticalStackLayout Grid.Column="1" Spacing="10">
                        <Label Text="Recurring" Style="{StaticResource Title2}" />
                        <CollectionView ItemsSource="{Binding Recurring}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RecurringTransaction">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Description}" Style="{StaticResource Body1}" />
                                            <Label Style="{StaticResource Caption1}" Opacity="0.7">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" />
                                                        <Span Text=" / " />
                                                        <Span Text="{Binding Frequency}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No recurring income" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>

                <!-- Chart -->
                <controls:BalanceChartView ChartData="{Binding ChartData}" Goals="{Binding Goals}"
                                           IsVisible="{Binding ChartData.Count, Converter={StaticResource IsNotNullConverter}}" />

                <!-- Transactions: Recent + Future side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <!-- Recent -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Recent" Style="{StaticResource Title2}" />
                        <CollectionView ItemsSource="{Binding RecentTransactions}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Transaction">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Description}" Style="{StaticResource Body1}" />
                                                <Label Style="{StaticResource Caption1}" Opacity="0.7">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TransactionDate, Converter={StaticResource DateDisplayConverter}}" />
                                                            <Span Text=" | " />
                                                            <Span Text="{Binding Category}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource Body1Strong}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No recent transactions" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Future -->
                    <VerticalStackLayout Grid.Column="1" Spacing="10">
                        <Label Text="Future" Style="{StaticResource Title2}" />
                        <CollectionView ItemsSource="{Binding FutureTransactions}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Transaction">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,8" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Description}" Style="{StaticResource Body1}" />
                                                <Label Text="{Binding TransactionDate, Converter={StaticResource DateDisplayConverter}}"
                                                       Style="{StaticResource Caption1}" Opacity="0.7" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource Body1Strong}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No future transactions" Style="{StaticResource Body1}" Opacity="0.5" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
