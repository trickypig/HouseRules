<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:HouseRules.PageModels"
             x:Class="HouseRules.Pages.LoginPage"
             x:DataType="pm:LoginPageModel"
             Title="House Rules"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" MaximumWidthRequest="400">

            <Label Text="House Rules" Style="{StaticResource LargeTitle}" HorizontalTextAlignment="Center" />
            <Label Text="Family Finance Manager" Style="{StaticResource Body1}"
                   HorizontalTextAlignment="Center" Opacity="0.7" />

            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"
                   ReturnType="Next" />

            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True"
                   ReturnType="Done" ReturnCommand="{Binding LoginCommand}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource NeonDanger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Login" Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Create Account" Command="{Binding GoToRegisterCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
