<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:HouseRules.PageModels"
             x:Class="HouseRules.Pages.RegisterPage"
             x:DataType="pm:RegisterPageModel"
             Title="Create Account">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center" MaximumWidthRequest="400">

            <Label Text="Create Account" Style="{StaticResource Title1}" HorizontalTextAlignment="Center" />

            <Entry Placeholder="Display Name" Text="{Binding DisplayName}" ReturnType="Next" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" ReturnType="Next" />
            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True"
                   ReturnType="Done" ReturnCommand="{Binding RegisterCommand}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource NeonDanger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Register" Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Back to Login" Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
